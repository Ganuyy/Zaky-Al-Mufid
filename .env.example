# ==========================================================================
# SipOrder - Contoh konfigurasi environment
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# ==========================================================================

APP_NAME="SipOrder"
APP_SHORT="SO"
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"

APP_ADDRESS="Jl. Bumi Lestari, Kabupaten Bekasi"
APP_PHONE="0899-0091-090"

# Ukuran kertas struk default: 58 atau 80 (mm)
RECEIPT_WIDTH=58

# --------------------------------------------------------------------------
# Database MySQL (XAMPP default)
# --------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopi_pintar
DB_USERNAME=root
DB_PASSWORD=
